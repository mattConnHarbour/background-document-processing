{
  "name": "background-document-processing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "concurrently -k -n client,api,worker \"vite --host 127.0.0.1 --port 5186 --strictPort\" \"tsx watch server/api.ts\" \"tsx watch server/worker.ts\"",
    "start:api": "tsx server/api.ts",
    "start:worker": "tsx server/worker.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.4.0",
    "@hocuspocus/server": "^2.13.6",
    "@superdoc/sdk": "2.10.0",
    "fastify": "^5.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "superdoc": "2.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.2.7"
  }
}
